@page "/calculator"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using MomsCalculator.DTO
@using MomsCalculator.Models
@using MomsCalculator.Models.Enums
@inject NavigationManager Navigation

<PageTitle>Mom's Calculator</PageTitle>

<nav class="topbar">
    <div class="nav-inner">
        <div class="nav-links">
            <a href="/" class="nav-link">Hjem</a>
            <a href="/calculator" class="nav-link active">land afregner</a>
            <a href="#" class="nav-link">Værktøjer</a>
            <a href="/brugt-moms" class="nav-link">Brugt moms</a>
        </div>
    </div>
</nav>

<div class="page-shell">
    <aside class="info-card">
        <h3>Vigtig info</h3>
        <p>
            Denne momsudregner hjælper med at beregne før/efter moms. Husk at nogle af landene kan have en reduceret sats, eller ingen moms på bestemte varer. Dette værktøj viser standardmomsen for landet, for mere detaljer, brug det avancerede værktøj
       
        </p>
    </aside>

    <section class="calculator-wrap">
        <div class="calculator-panel">
            <div class="calculator-card">
                <div class="field-row amount-row">
                    <label for="amount">Beløb</label>
                    <div class="input-box">
                        <input id="amount" type="number" step="0.01" @bind="Amount" @bind:after="Calculate" placeholder="00,00" />
                        <select @bind="SelectedCurrency" @bind:after="Calculate" aria-label="Currency">
                            @foreach (var currency in Enum.GetValues<ValutaEnum>())
                            {
                                <option value="@currency">@currency</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="field-row">
                    <label for="country">Vælg land</label>
                    <select id="country" @bind="SelectedCountry" @bind:after="Calculate">
                        @foreach (var country in Enum.GetValues<CountryEnum>())
                        {
                            <option value="@country">@GetCountryLabel(country)</option>
                        }
                    </select>
                </div>

                <div class="field-row">
                    <label for="mode">Før eller efter moms</label>
                    <select id="mode" @bind="SelectedDirection" @bind:after="Calculate">
                        @foreach (var direction in Enum.GetValues<VatDirectionEnum>())
                        {
                            <option value="@direction">@GetDirectionLabel(direction)</option>
                        }
                    </select>
                </div>

                <button class="calc-button" @onclick="Calculate" disabled="@IsBusy">
                    @(IsBusy ? "Beregner..." : "Beregn")
                </button>

                <div class="result-box">
                    <span class="result-label">Resultat</span>
                    <strong>@ResultText</strong>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private double Amount { get; set; } =0;
    private ValutaEnum SelectedCurrency { get; set; } = ValutaEnum.DKK;
    private CountryEnum SelectedCountry { get; set; } = CountryEnum.DK;
    private VatDirectionEnum SelectedDirection { get; set; } = VatDirectionEnum.BeforeVAT;
    private string ResultText { get; set; } = "0,00 DKK";
    private bool IsBusy { get; set; }

    private static string GetCountryLabel(CountryEnum country) => country switch
    {
        CountryEnum.AT => "Østrig - 20%",
        CountryEnum.BE => "Belgien - 21%",
        CountryEnum.BG => "Bulgarien - 20%",
        CountryEnum.HR => "Kroatien - 25%",
        CountryEnum.CY => "Cypern - 19%",
        CountryEnum.CZ => "Tjekkiet - 21%",
        CountryEnum.DK => "Danmark - 25%",
        CountryEnum.EE => "Estland - 24%",
        CountryEnum.FI => "Finland - 25,5%",
        CountryEnum.FR => "Frankrig - 20%",
        CountryEnum.DE => "Tyskland - 19%",
        CountryEnum.GR => "Grækenland - 24%",
        CountryEnum.HU => "Ungarn - 27%",
        CountryEnum.IE => "Irland - 23%",
        CountryEnum.IT => "Italien - 22%",
        CountryEnum.LV => "Letland - 21%",
        CountryEnum.LT => "Litauen - 21%",
        CountryEnum.LU => "Luxembourg - 17%",
        CountryEnum.MT => "Malta - 18%",
        CountryEnum.NL => "Nederlandene - 21%",
        CountryEnum.PL => "Polen - 23%",
        CountryEnum.PT => "Portugal - 23%",
        CountryEnum.RO => "Rumænien - 19%",
        CountryEnum.SK => "Slovakiet - 23%",
        CountryEnum.SI => "Slovenien - 22%",
        CountryEnum.ES => "Spanien - 21%",
        CountryEnum.SE => "Sverige - 25%",
        CountryEnum.GB => "Storbritannien - 20%",
        CountryEnum.US => "USA - 7%",
        _ => $"{country} - 0%"
    };

    private static string GetDirectionLabel(VatDirectionEnum direction) => direction switch
    {
        VatDirectionEnum.BeforeVAT => "Før moms",
        VatDirectionEnum.afterVAT => "Efter moms",
        _ => direction.ToString()
    };

    private async Task Calculate()
    {
        IsBusy = true;

        try
        {
            using var client = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
            var request = new CalculateVatRequestDTO
            {
                Amount = Amount,
                Country = SelectedCountry,
                Valuta = SelectedCurrency,
                Direction = SelectedDirection
            };

            var response = await client.PostAsJsonAsync("api/Calculator/Moms", request);
            if (!response.IsSuccessStatusCode)
            {
                ResultText = "Fejl ved beregning";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<VATResult>();
            ResultText = result is not null
                ? $"{result.FinalAmount:0.00} {SelectedCurrency}"
                : "Fejl ved beregning";
        }
        catch
        {
            ResultText = "Fejl ved beregning";
        }
        finally
        {
            IsBusy = false;
        }
    }
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&display=swap');

    :root {
        --border: #e8e7eb;
        --ink: #202536;
        --muted: #667080;
        --white: #ffffff;
        --accent: #315bea;
        --surface: #fffefe;
    }

    * {
        box-sizing: border-box;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: "Montserrat", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    html, body {
        margin: 0;
        background-color: #f7f9ff;
        background-image:
            radial-gradient(ellipse 34rem 26rem at 12% 18%, rgba(67, 190, 238, 0.34), transparent 68%),
            radial-gradient(ellipse 38rem 30rem at 86% 10%, rgba(57, 128, 244, 0.3), transparent 70%),
            radial-gradient(ellipse 34rem 28rem at 72% 92%, rgba(41, 190, 235, 0.28), transparent 70%);
        background-attachment: fixed;
        color: var(--ink);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
        min-height: 100vh;
        overflow: hidden;
    }

    .topbar {
        width: fit-content;
        max-width: calc(100% - 32px);
        margin: 24px auto 0;
        background: rgba(255, 255, 255, 0.68);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 22px;
        position: sticky;
        top: 24px;
        z-index: 10;
        box-shadow: 0 8px 24px rgba(32, 37, 54, 0.1);
    }

    .nav-inner {
        max-width: 100%;
        margin: 0 auto;
        height: 66px;
        display: flex;
        align-items: center;
        padding: 0 24px;
    }

    .nav-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
        white-space: nowrap;
    }

    .nav-link {
        font-size: 0.98rem;
        color: var(--ink);
        text-decoration: none;
        font-weight: 600;
        opacity: 0.82;
        transition: color 160ms ease, opacity 160ms ease;
    }

    .nav-link:hover {
        color: var(--accent);
        opacity: 1;
    }

    .nav-link.active {
        font-weight: 700;
        color: var(--accent);
        opacity: 1;
    }

    .page-shell {
        max-width: 1320px;
        margin: 0 auto;
        padding: 24px 28px 0;
        height: calc(100vh - 82px);
        display: grid;
        grid-template-columns: 260px minmax(0, 1fr);
        align-items: center;
        gap: 28px;
    }

    .info-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 22px 20px;
        box-shadow: 0 16px 40px rgba(32, 37, 54, 0.07);
        min-height: 220px;
    }

    .info-card h3 {
        margin: 0 0 12px;
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -0.04em;
    }

    .info-card p {
        margin: 0;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink);
        opacity: 0.8;
    }

    .calculator-wrap {
        margin-top: 0;
        border-radius: 28px;
        padding: 30px 24px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .calculator-panel {
        width: 100%;
    }

    .calculator-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 38px 40px 34px;
        box-shadow: 0 16px 40px rgba(32, 37, 54, 0.07);
        max-width: 800px;
        margin: 0 auto;
    }

    .field-row {
        display: grid;
        gap: 9px;
        margin-bottom: 24px;
    }

    .field-row label {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--ink);
    }

    .input-box {
        display: flex;
        align-items: center;
        border: 1px solid #d9dbe2;
        border-radius: 10px;
        overflow: hidden;
        background: var(--white);
        min-height: 56px;
        transition: border-color 160ms ease, box-shadow 160ms ease;
    }

    .input-box input {
        flex: 1;
        border: none;
        background: transparent;
        padding: 0 16px;
        font-size: 1.15rem;
        min-height: 56px;
        outline: none;
        color: var(--ink);
    }

    .input-box select {
        border: none;
        border-left: 1px solid #e1e3e8;
        background: #f7f8fa;
        min-height: 56px;
        padding: 0 18px;
        font-size: 1rem;
        color: var(--ink);
        outline: none;
    }

    select {
        width: 100%;
        min-height: 56px;
        border: 1px solid #d9dbe2;
        border-radius: 10px;
        background: var(--white);
        padding: 0 16px;
        font-size: 1rem;
        color: var(--ink);
        outline: none;
    }

    .result-box {
        margin-top: 30px;
        background: #f4f8fc;
        border: 1px solid #e1eaf3;
        border-radius: 12px;
        padding: 20px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }

    .calc-button {
        width: 100%;
        border: none;
        border-radius: 10px;
        background: var(--accent);
        color: white;
        font-size: 1rem;
        font-weight: 700;
        min-height: 52px;
        cursor: pointer;
        margin-top: 8px;
        transition: background 160ms ease, transform 160ms ease;
    }

    .calc-button:hover:not(:disabled) {
        background: #244ac8;
        transform: translateY(-1px);
    }

    .result-label {
        font-size: 0.94rem;
        font-weight: 600;
        color: var(--muted);
    }

    .result-box strong {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--accent);
    }

    @@media (max-width: 900px) {
        .calculator-wrap {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .calculator-card {
            padding: 28px 20px 24px;
        }

        .nav-inner {
            padding: 0 18px;
        }

        .nav-links {
            gap: 16px;
            overflow-x: auto;
        }

        .nav-link {
            font-size: 0.86rem;
        }

    }
</style>

