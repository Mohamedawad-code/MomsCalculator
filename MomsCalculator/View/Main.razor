@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using MomsCalculator.DTO
@using MomsCalculator.Models
@using MomsCalculator.Models.Enums
@inject NavigationManager Navigation

<PageTitle>Mom's Calculator</PageTitle>

<nav class="topbar">
    <div class="nav-inner">
        <div class="brand">Moms Udregner</div>
        <div class="nav-links">
            <a href="/" class="nav-link active">Hjem</a>
            <a href="#" class="nav-link">Advanceret regner</a>
        </div>
    </div>
</nav>

<div class="page-shell">
    <section class="calculator-wrap">
        <div class="calculator-panel">
            <div class="calculator-card">
                <div class="field-row amount-row">
                    <label for="amount">Beløb</label>
                    <div class="input-box">
                        <input id="amount" type="number" step="0.01" @bind="Amount" @bind:after="Calculate" placeholder="00,00" />
                        <select @bind="SelectedCurrency" @bind:after="Calculate" aria-label="Currency">
                            @foreach (var currency in Enum.GetValues<ValutaEnum>())
                            {
                                <option value="@currency">@currency</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="field-row">
                    <label for="country">Vælg land</label>
                    <select id="country" @bind="SelectedCountry" @bind:after="Calculate">
                        @foreach (var country in Enum.GetValues<CountryEnum>())
                        {
                            <option value="@country">@GetCountryLabel(country)</option>
                        }
                    </select>
                </div>

                <div class="field-row">
                    <label for="mode">Før eller efter moms</label>
                    <select id="mode" @bind="SelectedDirection" @bind:after="Calculate">
                        @foreach (var direction in Enum.GetValues<VatDirectionEnum>())
                        {
                            <option value="@direction">@GetDirectionLabel(direction)</option>
                        }
                    </select>
                </div>

                <button class="calc-button" @onclick="Calculate" disabled="@IsBusy">
                    @(IsBusy ? "Beregner..." : "Beregn")
                </button>

                <div class="result-box">
                    <span class="result-label">Resultat</span>
                    <strong>@ResultText</strong>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private double Amount { get; set; } =0;
    private ValutaEnum SelectedCurrency { get; set; } = ValutaEnum.DKK;
    private CountryEnum SelectedCountry { get; set; } = CountryEnum.DK;
    private VatDirectionEnum SelectedDirection { get; set; } = VatDirectionEnum.BeforeVAT;
    private string ResultText { get; set; } = "0,00 DKK";
    private bool IsBusy { get; set; }

    private static string GetCountryLabel(CountryEnum country) => country switch
    {
        CountryEnum.AT => "Østrig",
        CountryEnum.BE => "Belgien",
        CountryEnum.BG => "Bulgarien",
        CountryEnum.HR => "Kroatien",
        CountryEnum.CY => "Cypern",
        CountryEnum.CZ => "Tjekkiet",
        CountryEnum.DK => "Danmark",
        CountryEnum.EE => "Estland",
        CountryEnum.FI => "Finland",
        CountryEnum.FR => "Frankrig",
        CountryEnum.DE => "Tyskland",
        CountryEnum.GR => "Grækenland",
        CountryEnum.HU => "Ungarn",
        CountryEnum.IE => "Irland",
        CountryEnum.IT => "Italien",
        CountryEnum.LV => "Letland",
        CountryEnum.LT => "Litauen",
        CountryEnum.LU => "Luxembourg",
        CountryEnum.MT => "Malta",
        CountryEnum.NL => "Nederlandene",
        CountryEnum.PL => "Polen",
        CountryEnum.PT => "Portugal",
        CountryEnum.RO => "Rumænien",
        CountryEnum.SK => "Slovakiet",
        CountryEnum.SI => "Slovenien",
        CountryEnum.ES => "Spanien",
        CountryEnum.SE => "Sverige",
        CountryEnum.GB => "Storbritannien",
        CountryEnum.US => "USA",
        _ => country.ToString()
    };

    private static string GetDirectionLabel(VatDirectionEnum direction) => direction switch
    {
        VatDirectionEnum.BeforeVAT => "Før moms",
        VatDirectionEnum.afterVAT => "Efter moms",
        _ => direction.ToString()
    };

    private async Task Calculate()
    {
        IsBusy = true;

        try
        {
            using var client = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
            var request = new CalculateVatRequestDTO
            {
                Amount = Amount,
                Country = SelectedCountry,
                Valuta = SelectedCurrency,
                Direction = SelectedDirection
            };

            var response = await client.PostAsJsonAsync("api/Calculator", request);
            if (!response.IsSuccessStatusCode)
            {
                ResultText = "Fejl ved beregning";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<VATResult>();
            ResultText = result is not null
                ? $"{result.FinalAmount:0.00} {SelectedCurrency}"
                : "Fejl ved beregning";
        }
        catch
        {
            ResultText = "Fejl ved beregning";
        }
        finally
        {
            IsBusy = false;
        }
    }
}

<style>
    :root {
        --bg: #f3f1f0;
        --panel: #f8f5f4;
        --border: #e2dedd;
        --ink: #1d2430;
        --muted: #66707d;
        --soft: #f8f6f5;
        --accent: #2e7ae8;
        --accent-strong: #1e62c9;
        --white: #ffffff;
        --shadow: rgba(26, 33, 41, 0.06);
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        background: #6377F6;
        color: var(--ink);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
        min-height: 100vh;
        overflow: hidden;
    }

    .topbar {
        background: rgba(255, 255, 255, 0.85);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .nav-inner {
        max-width: 1320px;
        margin: 0 auto;
        height: 76px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 28px;
        gap: 20px;
    }

    .brand {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -0.04em;
        white-space: nowrap;
        justify-self: start;
    }

    .nav-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 26px;
        justify-self: center;
    }

    .nav-link {
        font-size: 1.05rem;
        color: var(--ink);
        text-decoration: none;
        font-weight: 500;
        opacity: 0.9;
    }

    .nav-link:hover {
        opacity: 1;
    }

    .nav-link.active {
        font-weight: 700;
    }

    .page-shell {
        max-width: 1320px;
        margin: 0 auto;
        padding: 10px 28px 0;
        height: calc(100vh - 76px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .calculator-wrap {
        margin-top: 0;
        border-radius: 28px;
        padding: 30px 24px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .calculator-panel {
        width: 100%;
    }

    .calculator-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 28px 26px 24px;
        box-shadow: 0 10px 25px var(--shadow);
        max-width: 800px;
        margin: 0 auto;
    }

    .field-row {
        display: grid;
        gap: 10px;
        margin-bottom: 20px;
    }

    .field-row label {
        font-size: 1rem;
        font-weight: 600;
        color: var(--ink);
    }

    .input-box {
        display: flex;
        align-items: center;
        border: 1px solid #d8d2d0;
        border-radius: 12px;
        overflow: hidden;
        background: var(--white);
        min-height: 56px;
    }

    .input-box input {
        flex: 1;
        border: none;
        background: transparent;
        padding: 0 16px;
        font-size: 1.15rem;
        min-height: 56px;
        outline: none;
        color: var(--ink);
    }

    .input-box select {
        border: none;
        border-left: 1px solid #e4dfde;
        background: #f7f4f3;
        min-height: 56px;
        padding: 0 18px;
        font-size: 1rem;
        color: var(--ink);
        outline: none;
    }

    select {
        width: 100%;
        min-height: 56px;
        border: 1px solid #d8d2d0;
        border-radius: 12px;
        background: var(--white);
        padding: 0 16px;
        font-size: 1rem;
        color: var(--ink);
        outline: none;
    }

    .result-box {
        margin-top: 26px;
        background: #f5f6f7;
        border: 1px solid #e2e8ee;
        border-radius: 14px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }

    .calc-button {
        width: 100%;
        border: none;
        border-radius: 12px;
        background: #2e7ae8;
        color: white;
        font-size: 1rem;
        font-weight: 700;
        min-height: 52px;
        cursor: pointer;
        margin-top: 8px;
    }

    .result-label {
        font-size: 1rem;
        font-weight: 600;
        color: var(--muted);
    }

    .result-box strong {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--ink);
    }

    @@media (max-width: 900px) {
        .calculator-wrap {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .calculator-card {
            padding: 22px 18px 18px;
        }
    }
</style>

