@page "/"

<PageTitle>Hjem</PageTitle>

<nav class="topbar">
	<div class="nav-inner">
		<div class="brand">Moms Udregner</div>
		<div class="nav-links">
			<a href="/" class="nav-link active">Hjem</a>
			<a href="/calculator" class="nav-link">land afregner</a>
			<a href="#" class="nav-link">Advanceret regner</a>
			<a href="/brugt-moms" class="nav-link">Brugt moms</a>
		</div>
	</div>
</nav>

<main class="home-content">
	<section class="welcome-row">
		<div>
			<p class="eyebrow">MOMS WORKSPACE</p>
			<h1 class="typing-heading" aria-label="@HeadingVariation" style="--typing-steps: @HeadingVariation.Length; --typing-duration: @(HeadingVariation.Length * 55)ms;">@HeadingVariation<span class="typing-cursor" aria-hidden="true"></span></h1>
			<p class="intro">Alt Moms i et sted, brug forskellige værktøjer til at beregne moms</p>
		</div>
		<div class="workspace-status"><span class="status-dot"></span>Systemet er online</div>
	</section>

	<section class="overview-grid" aria-label="Moms værktøjer">
		<a class="tool-card tool-card-primary" href="/calculator">
			<div class="tool-icon">%</div>
			<div class="tool-copy">
				<span class="tool-kicker">STANDARDVÆRKTØJ</span>
				<h2>Land afregner</h2>
				<p>Beregn moms før eller efter beløbet for 30 lande.</p>
			</div>
			<span class="tool-arrow" aria-hidden="true">&#8594;</span>
		</a>

		<a class="tool-card" href="/brugt-moms">
			<div class="tool-icon tool-icon-warm">↗</div>
			<div class="tool-copy">
				<span class="tool-kicker">SPECIALBEREGNER</span>
				<h2>Brugt moms</h2>
				<p>Find momsen af din avance ved salg af brugte varer.</p>
			</div>
			<span class="tool-arrow" aria-hidden="true">&#8594;</span>
		</a>
	</section>

	<section class="dashboard-grid">
		<div class="panel activity-panel">
			<div class="panel-heading">
				<div>
					<p class="eyebrow">OVERBLIK</p>
					<h2>Dine værktøjer</h2>
				</div>
				<span class="panel-count">02 aktive</span>
			</div>
			<div class="activity-row">
				<span class="activity-mark">%</span>
				<div><strong>Land afregner</strong><span>Før og efter moms</span></div>
				<a href="/calculator">Åbn</a>
			</div>
			<div class="activity-row">
				<span class="activity-mark warm-mark">↗</span>
				<div><strong>Brugt moms</strong><span>Moms på fortjeneste</span></div>
				<a href="/brugt-moms">Åbn</a>
			</div>
		</div>

		<aside class="panel tip-panel">
			<p class="eyebrow">HURTIGT TIP</p>
			<h2>Brug standardmomsen som udgangspunkt</h2>
			<p>Satser kan variere efter varetype. Brug altid den gældende sats, når beregningen skal bruges i praksis.</p>
			<a class="text-link" href="/calculator">Start en beregning <span aria-hidden="true">&#8594;</span></a>
		</aside>
	</section>
</main>

@code {
	private static readonly string[] HeadingVariations =
	[
		"Velkommen! Er vi moms klar?",
		"Hey! Skal vi få styr på momsen?",
		"Hej! kan vi tælle til moms sammen?",
		"Hey! Moms er ikke så svært som ingen tror",
		"Hello! Skal vi regne lidt moms?",
		"Hey! Har din chef sendt dig for regne moms?"
	];

	private string HeadingVariation { get; set; } = HeadingVariations[0];

	protected override void OnInitialized()
	{
		HeadingVariation = HeadingVariations[Random.Shared.Next(HeadingVariations.Length)];
	}
}

<style>
	:root {
		--accent: #315bea;
		--ink: #202536;
		--muted: #667080;
		--line: #e8e7eb;
		--white: #ffffff;
	}

	* {
		box-sizing: border-box;
	}

	html, body {
		margin: 0;
		background-color: #f7f9ff;
		background-image:
			radial-gradient(ellipse 34rem 26rem at 12% 18%, rgba(67, 190, 238, 0.34), transparent 68%),
			radial-gradient(ellipse 38rem 30rem at 86% 10%, rgba(57, 128, 244, 0.3), transparent 70%),
			radial-gradient(ellipse 34rem 28rem at 72% 92%, rgba(41, 190, 235, 0.28), transparent 70%);
		background-attachment: fixed;
		color: var(--ink);
		font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
	}

	.topbar {
		background: var(--white);
		border-bottom: 1px solid #f0eef0;
		position: sticky;
		top: 0;
		z-index: 10;
		box-shadow: 0 2px 12px rgba(32, 37, 54, 0.03);
	}

	.nav-inner {
		max-width: 1320px;
		margin: 0 auto;
		height: 82px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 0 42px;
		gap: 28px;
	}

	.brand {
		font-size: 1.55rem;
		font-weight: 800;
		font-family: "Montserrat", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
		color: var(--accent);
		letter-spacing: -0.03em;
		white-space: nowrap;
		justify-self: start;
	}

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 34px;
		justify-self: center;
	}

	.nav-link {
		font-size: 0.98rem;
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		opacity: 0.82;
		transition: color 160ms ease, opacity 160ms ease;
	}

	.nav-link:hover,
	.nav-link.active {
		color: var(--accent);
		opacity: 1;
	}

	.nav-link.active {
		font-weight: 700;
	}

	.home-content {
		max-width: 1180px;
		margin: 0 auto;
		padding: 54px 32px 72px;
	}

	.welcome-row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 34px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: var(--accent);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	h1, h2 {
		margin: 0;
		font-family: "Montserrat", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
		letter-spacing: -0.04em;
	}

	h1 {
		max-width: 650px;
		font-size: clamp(2rem, 4vw, 3.35rem);
		line-height: 1.49;
		min-height: 1.16em;
	}

	.typing-heading {
		display: block;
		clip-path: inset(0 100% 0 0);
		white-space: nowrap;
		width: fit-content;
		max-width: 100%;
		animation: typing var(--typing-duration) steps(var(--typing-steps), end) both;
	}

	@@keyframes typing {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	.typing-cursor {
		animation: blink 800ms step-end infinite;
		border-right: 3px solid var(--accent);
		display: inline-block;
		height: 0.85em;
		margin-left: 5px;
		vertical-align: -0.04em;
	}

	@@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.intro {
		max-width: 600px;
		margin: 16px 0 0;
		color: var(--muted);
		font-size: 1.02rem;
		line-height: 1.6;
	}

	.workspace-status {
		align-items: center;
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--muted);
		display: inline-flex;
		font-size: 0.84rem;
		font-weight: 600;
		gap: 9px;
		padding: 10px 14px;
		white-space: nowrap;
	}

	.status-dot {
		background: #35a66f;
		border-radius: 50%;
		height: 8px;
		width: 8px;
	}

	.overview-grid,
	.dashboard-grid {
		display: grid;
		gap: 18px;
	}

	.overview-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.tool-card {
		align-items: center;
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: 16px;
		box-shadow: 0 10px 24px rgba(32, 37, 54, 0.04);
		color: var(--ink);
		display: flex;
		gap: 18px;
		min-height: 178px;
		padding: 26px;
		text-decoration: none;
		transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
	}

	.tool-card:hover {
		border-color: #aab9ef;
		box-shadow: 0 16px 30px rgba(32, 37, 54, 0.09);
		transform: translateY(-2px);
	}

	.tool-card-primary {
		background: #eef2ff;
		border-color: #d7dffb;
	}

	.tool-icon,
	.activity-mark {
		align-items: center;
		background: var(--accent);
		border-radius: 12px;
		color: var(--white);
		display: flex;
		flex: 0 0 auto;
		font-size: 1.35rem;
		font-weight: 800;
		height: 48px;
		justify-content: center;
		width: 48px;
	}

	.tool-icon-warm,
	.warm-mark {
		background: #e58c58;
	}

	.tool-copy {
		flex: 1;
	}

	.tool-kicker {
		color: var(--muted);
		display: block;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		margin-bottom: 7px;
	}

	.tool-copy h2 {
		font-size: 1.35rem;
	}

	.tool-copy p {
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.45;
		margin: 7px 0 0;
	}

	.tool-arrow {
		color: var(--accent);
		font-size: 1.4rem;
		font-weight: 700;
	}

	.dashboard-grid {
		grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
		margin-top: 18px;
	}

	.panel {
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: 16px;
		padding: 26px;
	}

	.panel-heading {
		align-items: flex-start;
		display: flex;
		justify-content: space-between;
		margin-bottom: 18px;
	}

	.panel h2 {
		font-size: 1.35rem;
	}

	.panel-count {
		background: #f1f3f7;
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 700;
		padding: 7px 10px;
	}

	.activity-row {
		align-items: center;
		border-top: 1px solid #eef0f4;
		display: flex;
		gap: 13px;
		padding: 15px 0;
	}

	.activity-mark {
		border-radius: 9px;
		font-size: 1rem;
		height: 36px;
		width: 36px;
	}

	.activity-row div {
		display: grid;
		gap: 4px;
		flex: 1;
	}

	.activity-row strong {
		font-size: 0.9rem;
	}

	.activity-row div span {
		color: var(--muted);
		font-size: 0.8rem;
	}

	.activity-row a,
	.text-link {
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 800;
		text-decoration: none;
	}

	.tip-panel {
		background: #202536;
		border-color: #202536;
		color: var(--white);
	}

	.tip-panel .eyebrow {
		color: #9fb2ff;
	}

	.tip-panel h2 {
		font-size: 1.45rem;
		line-height: 1.2;
	}

	.tip-panel > p:not(.eyebrow) {
		color: #cbd1df;
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 16px 0 24px;
	}

	.tip-panel .text-link {
		color: #b7c4ff;
	}

	@@media (max-width: 700px) {
		.home-content {
			padding: 36px 18px 48px;
		}

		.welcome-row,
		.overview-grid,
		.dashboard-grid {
			grid-template-columns: 1fr;
		}

		.welcome-row {
			align-items: flex-start;
			flex-direction: column;
		}

		.workspace-status {
			font-size: 0.78rem;
		}

		.tool-card {
			padding: 20px;
		}

		.nav-inner {
			height: 72px;
			padding: 0 20px;
		}

		.nav-links {
			gap: 14px;
		}

		.nav-link {
			font-size: 0.86rem;
		}

		.brand {
			font-size: 1.25rem;
		}
	}
</style>
