@page "/"

<PageTitle>Hjem</PageTitle>

<nav class="topbar">
	<div class="nav-inner">
		<div class="brand">Moms Udregner</div>
		<div class="nav-links">
			<a href="/" class="nav-link active">Hjem</a>
			<a href="/calculator" class="nav-link">land afregner</a>
			<a href="#" class="nav-link">Advanceret regner</a>
			<a href="/brugt-moms" class="nav-link">Brugt moms</a>
		</div>
	</div>
</nav>

<main class="home-content">
	<h1>Velkommen</h1>
	<p>Vælg en beregner i menuen for at komme i gang.</p>
</main>

<style>
	:root {
		--accent: #315bea;
		--ink: #202536;
		--white: #ffffff;
	}

	* {
		box-sizing: border-box;
	}

	html, body {
		margin: 0;
		background: #fcf8f9;
		color: var(--ink);
		font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
	}

	.topbar {
		background: var(--white);
		border-bottom: 1px solid #f0eef0;
		position: sticky;
		top: 0;
		z-index: 10;
		box-shadow: 0 2px 12px rgba(32, 37, 54, 0.03);
	}

	.nav-inner {
		max-width: 1320px;
		margin: 0 auto;
		height: 82px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 0 42px;
		gap: 28px;
	}

	.brand {
		font-size: 1.55rem;
		font-weight: 800;
		font-family: "Montserrat", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
		color: var(--accent);
		letter-spacing: -0.03em;
		white-space: nowrap;
		justify-self: start;
	}

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 34px;
		justify-self: center;
	}

	.nav-link {
		font-size: 0.98rem;
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		opacity: 0.82;
		transition: color 160ms ease, opacity 160ms ease;
	}

	.nav-link:hover,
	.nav-link.active {
		color: var(--accent);
		opacity: 1;
	}

	.nav-link.active {
		font-weight: 700;
	}

	.home-content {
		max-width: 900px;
		margin: 0 auto;
		padding: 96px 28px;
		text-align: center;
	}

	@@media (max-width: 700px) {
		.nav-inner {
			height: 72px;
			padding: 0 20px;
		}

		.nav-links {
			gap: 14px;
		}

		.nav-link {
			font-size: 0.86rem;
		}

		.brand {
			font-size: 1.25rem;
		}
	}
</style>
