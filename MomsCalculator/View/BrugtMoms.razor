@page "/brugt-moms"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using MomsCalculator.DTO
@using MomsCalculator.Models
@inject NavigationManager Navigation

<PageTitle>Brugt moms</PageTitle>

<nav class="topbar">
    <div class="nav-inner">
        <div class="brand">Moms Udregner</div>
        <div class="nav-links">
            <a href="/" class="nav-link">Hjem</a>
            <a href="#" class="nav-link">Advanceret regner</a>
            <a href="/brugt-moms" class="nav-link active">Brugt moms</a>
        </div>
    </div>
</nav>

<main class="used-vat-shell">
    <section class="used-vat-card">
        <div class="field-row">
            <label for="used-item-amount">Beløb på brugt vare</label>
            <input id="used-item-amount" type="number" step="0.01" min="0" @bind="UsedItemAmount" @bind:after="CalculateVat" />
        </div>

        <div class="field-row">
            <label for="sale-price">Pris til salg</label>
            <input id="sale-price" type="number" step="0.01" min="0" @bind="SalePrice" @bind:after="CalculateVat" />
        </div>

        <div class="total-row">
            <span>Total moms</span>
            <strong>@TotalVat.ToString("0.00") DKK</strong>
        </div>
    </section>
</main>

@code {
    private decimal UsedItemAmount { get; set; }
    private decimal SalePrice { get; set; }
    private decimal TotalVat { get; set; }

    private async Task CalculateVat()
    {
        try
        {
            using var client = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
            var request = new UsedResultDTO
            {
                OriginalAmount = (double)UsedItemAmount,
                SellingAmount = (double)SalePrice
            };

            var response = await client.PostAsJsonAsync("api/Calculator/UsedMoms", request);
            if (!response.IsSuccessStatusCode)
            {
                TotalVat = 0;
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<UsedVATResult>();
            TotalVat = result is not null ? (decimal)result.Result : 0;
        }
        catch
        {
            TotalVat = 0;
        }
    }
}

<style>
    :root {
        --border: #e8e7eb;
        --ink: #202536;
        --muted: #667080;
        --white: #ffffff;
        --accent: #315bea;
        --surface: #fffefe;
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        background: #fcf8f9;
        color: var(--ink);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
        min-height: 100vh;
        overflow: hidden;
    }

    .topbar {
        background: var(--white);
        border-bottom: 1px solid #f0eef0;
        position: sticky;
        top: 0;
        z-index: 10;
        box-shadow: 0 2px 12px rgba(32, 37, 54, 0.03);
    }

    .nav-inner {
        max-width: 1320px;
        margin: 0 auto;
        height: 82px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 42px;
        gap: 28px;
    }

    .brand {
        font-size: 1.55rem;
        font-weight: 800;
        color: var(--accent);
        letter-spacing: -0.03em;
        white-space: nowrap;
        justify-self: start;
    }

    .nav-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 34px;
        justify-self: center;
    }

    .nav-link {
        font-size: 0.98rem;
        color: var(--ink);
        text-decoration: none;
        font-weight: 600;
        opacity: 0.82;
        transition: color 160ms ease, opacity 160ms ease;
    }

    .nav-link:hover {
        color: var(--accent);
        opacity: 1;
    }

    .nav-link.active {
        font-weight: 700;
        color: var(--accent);
        opacity: 1;
    }

    .used-vat-shell {
        min-height: calc(100vh - 82px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 28px;
    }

    .used-vat-card {
        width: min(100%, 720px);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 38px 40px 34px;
        box-shadow: 0 16px 40px rgba(32, 37, 54, 0.07);
    }

    .field-row {
        display: grid;
        gap: 9px;
        margin-bottom: 24px;
    }

    .field-row label {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--ink);
    }

    .field-row input {
        width: 100%;
        min-height: 54px;
        border: 1px solid #d9dbe2;
        border-radius: 10px;
        background: var(--white);
        padding: 0 16px;
        font-size: 1.05rem;
        color: var(--ink);
        outline: none;
        transition: border-color 160ms ease, box-shadow 160ms ease;
    }

    .field-row input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(49, 91, 234, 0.12);
    }

    .total-row {
        margin-top: 30px;
        background: #f4f8fc;
        border: 1px solid #e1eaf3;
        border-radius: 12px;
        padding: 20px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }

    .total-row span {
        font-size: 0.94rem;
        font-weight: 600;
        color: var(--muted);
    }

    .total-row strong {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--accent);
    }

    @@media (max-width: 600px) {
        .used-vat-shell {
            padding: 24px 18px;
        }

        .used-vat-card {
            padding: 28px 20px 24px;
        }

        .nav-inner {
            height: 72px;
            padding: 0 20px;
        }

        .nav-links {
            gap: 14px;
        }

        .nav-link {
            font-size: 0.86rem;
        }

        .brand {
            font-size: 1.25rem;
        }
    }
</style>
